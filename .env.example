# ============================================================
# AI Village 环境变量配置
# 复制此文件为 .env 并填入实际的 API Key
# ============================================================

# DeepSeek API Key (必填)
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API Base URL (默认值，一般不用改)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称 (deepseek-chat = DeepSeek Flash, 性价比最高)
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 可选配置
# ============================================================

# LangSmith 追踪 (可选，用于调试 LLM 调用链)
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=ls_your-key-here
# LANGCHAIN_PROJECT=ai-village

# 世界参数 (可调)
# TICK_INTERVAL_SECONDS=1.5
# TIME_SPEED_MULTIPLIER=10
